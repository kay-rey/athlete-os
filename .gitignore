# --- OS / Finder ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
ehthumbs.db
Icon[
]

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.settings/
*.code-workspace

# --- Secrets & local env (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets/
.secrets/

# --- Temp / scratch ---
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
*~
.cache/
tmp/
temp/
.trash/

# --- Logs & local notes ---
*.log
logs/
.local/

# --- Journal working copies (keep tracked CSVs; ignore exports/edits) ---
journal/*.local.csv
journal/*_backup.csv
journal/.~*
data/*.local.csv
data/*_backup.csv
data/.~*
~$*.csv
~$*.xlsx
*.xlsx
*.xls

# --- Office / OS lock files ---
~$*
*.docx.bak

# --- Python (if tooling added later) ---
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- Node (if tooling added later) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# --- Cursor / agent local ---
.cursor/mcp.json
.cursor/*.local.*

# --- Archives & media dumps ---
*.zip
*.tar
*.tar.gz
*.7z
*.dmg
*.iso
